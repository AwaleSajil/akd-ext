OPENAI_API_KEY="xxxxxxxxxx"
CODE_SEARCH_MCP_URL="xxxxxxxxxx"
CODE_SEARCH_MCP_KEY="xxxxxxxxxx"
ADS_SEARCH_MCP_URL="xxxxxxxxxx"
CODE_SEARCH_ADS_SEARCH_KEY="xxxxxxxxxx"
PDS_MCP_KEY="xxxxxxxxxx"
# CM1 Temporal MCP Server
CM1_MCP_URL="https://fm.prism.nasa-impact.net/akd/cm1-mcp"
CM1_MCP_API_KEY="xxxxxxxxxx"

# Mock job-management MCP server (still used by Stage 5 status/figures)
EXPERIMENT_STATUS_MCP_URL="xxxxxxxxxx"
EXPERIMENT_STATUS_MCP_KEY="xxxxxxxxxx"

# ── Citation-report tools (akd_ext/tools/citation_report) ──────────────────────
# Semantic Scholar (citations + paper resolution). Optional but recommended to avoid
# HTTP 429 rate limiting. Get one at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY="xxxxxxxxxx"
# Throttle between Semantic Scholar requests, seconds (default 2).
SEMANTIC_SCHOLAR_MIN_INTERVAL_S="2"
# Email passed to Unpaywall when downloading PDFs by DOI (required by their TOS).
UNPAYWALL_EMAIL="you@example.com"

# S3 cache for citation lists, PDFs, and reports.
FM_S3_BUCKET="akd-citation-report-agent-cache"
FM_S3_PREFIX="fm-report-cache"

# AWS credentials + region for the S3 cache. boto3 reads these from the environment.
# Use a long-lived IAM access key for deployment; temporary STS creds (with
# AWS_SESSION_TOKEN) work for local testing but expire. Do NOT set AWS_PROFILE in a
# cloud deployment (there is no SSO there).
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID="xxxxxxxxxx"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxx"
# AWS_SESSION_TOKEN="xxxxxxxxxx"   # only when using temporary STS credentials
